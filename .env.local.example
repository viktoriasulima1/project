# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Local:   postgresql://postgres:password@localhost:5432/farmos
# Supabase: postgresql://postgres.[ref]:[password]@[host]:5432/postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/farmos"

# ─── Clerk Authentication ─────────────────────────────────────────────────────
# Get these from: https://dashboard.clerk.com → Your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# After login/logout redirect targets
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ─── Weather ─────────────────────────────────────────────────────────────────
# Open-Meteo is free — no API key required.
# Set default farm coordinates (used for weather before a farm is configured).
NEXT_PUBLIC_FARM_LATITUDE="51.9652"
NEXT_PUBLIC_FARM_LONGITUDE="5.9307"

# ─── Dev-only farm resolution fallback ────────────────────────────────────────
# Uncomment ONLY if you're testing locally without Clerk signed in and need
# getActiveFarm() to fall back to the first farm in the database. Requires
# NODE_ENV=development too (never usable in production regardless of this
# flag). Prefer the "Load demo farm" button shown on the dashboard instead —
# it explicitly links the demo farm to your real signed-in Clerk session.
# ALLOW_DEV_FARM_FALLBACK="true"

# Optional: override the Clerk user id `prisma/seed.ts` links the demo farm
# to. Set this to your own Clerk user id, then re-run `npx prisma db seed`.
# DEV_SEED_USER_ID="user_..."
