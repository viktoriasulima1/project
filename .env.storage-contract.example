# ─────────────────────────────────────────────────────────────────────────────
# Scouting private photo storage — production contract configuration EXAMPLE
# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env.storage-contract` (git-ignored) and fill with REAL values for a
# LOCAL contract run only. NEVER commit real credentials. Every value below is a
# non-secret PLACEHOLDER. These are validated by
# src/lib/scouting/storage-config.ts (validatePhotoStorageConfig) at runtime and
# checked read-only by `npm run test:storage:preflight`.
#
# Run:  $env:STORAGE_CONTRACT_TEST="true"; npm run test:storage:preflight
#       $env:STORAGE_CONTRACT_TEST="true"; npm run test:storage:contract
#
# Secrets are SERVER-ONLY — never prefix any of these with NEXT_PUBLIC_.
#
# Two shared production providers are supported:
#   • s3_compatible  — direct AWS S3 / MinIO / Ceph RGW / R2 / B2 (new; SigV4 in
#                      src/lib/scouting/s3-compatible-storage.ts, no SDK).
#   • object_gateway — a FarmOS gateway HTTP service that fronts a private bucket.
# The variable names below are the project's SCOUTING_PHOTO_* equivalents of the
# canonical PHOTO_STORAGE_* names (shown in brackets).

# Provider selector [PHOTO_STORAGE_PROVIDER]. s3_compatible for a direct S3 path.
SCOUTING_PHOTO_STORAGE_PROVIDER="s3_compatible"

# S3 endpoint — HTTPS ONLY [PHOTO_STORAGE_ENDPOINT]. e.g. AWS
# https://s3.eu-west-1.amazonaws.com  or a MinIO host https://minio.internal:9000
SCOUTING_PHOTO_ENDPOINT="https://s3.eu-west-1.provider.example"

# Region [PHOTO_STORAGE_REGION].
SCOUTING_PHOTO_REGION="eu-west-1"

# Private bucket [PHOTO_STORAGE_BUCKET]. Must NOT be public-read.
SCOUTING_PHOTO_BUCKET="farmos-scouting-private"
SCOUTING_PHOTO_BUCKET_PUBLIC="false"

# Path-style addressing [PHOTO_STORAGE_FORCE_PATH_STYLE] — true for MinIO/Ceph,
# usually false for AWS S3.
SCOUTING_PHOTO_FORCE_PATH_STYLE="true"

# Credentials (server-only). Placeholder/example/change-me values are rejected.
SCOUTING_PHOTO_ACCESS_KEY="REPLACE_WITH_REAL_ACCESS_KEY_ID"        # [PHOTO_STORAGE_ACCESS_KEY_ID]
SCOUTING_PHOTO_SECRET_KEY="REPLACE_WITH_REAL_SECRET_ACCESS_KEY"    # [PHOTO_STORAGE_SECRET_ACCESS_KEY]

# FarmOS internal signed-read HMAC secret (server-only). Required in production —
# the client only ever receives a FarmOS route, never a raw S3 URL/key.
SCOUTING_PHOTO_SIGNING_SECRET="REPLACE_WITH_REAL_SIGNING_SECRET"

# Signed URL lifetime, seconds — MUST be 60–900 [PHOTO_STORAGE_SIGNED_URL_SECONDS].
SCOUTING_PHOTO_SIGNED_SECONDS="300"

# Max upload size per photo, bytes — default 8388608 (8 MB) [PHOTO_STORAGE_MAX_UPLOAD_BYTES].
SCOUTING_PHOTO_MAX_UPLOAD_BYTES="8388608"

# Retention policy, days — MUST be >= 1 [PHOTO_STORAGE_RETENTION_DAYS].
SCOUTING_PHOTO_RETENTION_DAYS="365"

# Dedicated synthetic contract prefix [PHOTO_STORAGE_CONTRACT_PREFIX] — the
# contract writes ONLY under this scope, never a real farm/visit/photo.
SCOUTING_PHOTO_CONTRACT_PREFIX="synthetic-contract"

# Explicit contract opt-in; the contract refuses to run without it.
STORAGE_CONTRACT_TEST="true"

# ─── object_gateway alternative (if not using direct S3) ──────────────────────
# SCOUTING_PHOTO_STORAGE_PROVIDER="object_gateway"
# (same ENDPOINT/REGION/BUCKET/ACCESS_KEY/SECRET_KEY variables; the gateway
#  fronts the bucket and vendor mapping lives in that service, not in FarmOS.)
