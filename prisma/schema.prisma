// ─── Sprint 19 — Audit trail & compliance export enumerations ─────────────────

// Sprint 19 Part 14: no multi-user roles exist yet — every audit event today
// is either the farm's own owner acting through the UI, or FarmOS itself
// acting without a human in the loop (e.g. a scheduled Ctgb sync). See
// docs/AUDIT_TRAIL_ARCHITECTURE.md for why "farmer" is the only human actor
// type today and how this should extend when real multi-user roles exist.
enum AuditActorType {
  farmer
  system
  api
}

enum AuditAction {
  created
  planned
  completed
  corrected
  reversed
  archived
  restored
  exported
  verification_status_changed
  inventory_adjusted
  compliance_snapshot_created
  allocation_created
  allocation_changed
  allocation_reversed
}

enum AuditSource {
  web
  mobile_web
  quick_log
  onboarding
  import
  system
  api
  e2e_test
  offline_sync
}

