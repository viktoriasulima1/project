generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User locale preference (i18n Phase 2). Standalone + Clerk-user scoped because
// FarmOS has no user table (identity is Clerk; Farm is keyed by clerkUserId).
// Stores only a canonical, supported locale token — never a translated label.
model UserLocalePreference {
  id          String   @id @default(uuid())
  clerkUserId String   @unique
  locale      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

