// Sprint 19 — an append-only record of every regulated action taken on this
// farm's data. Deliberately generic (entityType/entityId as strings, not a
// dozen nullable FK columns) so one table covers Activity corrections,
// reversals, exports, and future entity types without a schema change each
// time. Application code NEVER calls .update()/.delete() on this model — see
// docs/AUDIT_TRAIL_ARCHITECTURE.md for the full append-only enforcement
// story (application-level + a DB trigger, both, defense in depth).
model AuditEvent {
  id                String         @id @default(uuid())
  farmId            String
  actorUserId       String?
  actorType         AuditActorType @default(farmer)
  entityType        String
  entityId          String
  action            AuditAction
  occurredAt        DateTime       @default(now())
  source            AuditSource
  previousVersionId String?
  correlationId     String
  reason            String?
  // Structured, versioned metadata — never a raw request body or full
  // record dump (Sprint 19 Part 15). Always shaped like
  // { schemaVersion: 1, ...safe fields }.
  metadataJson      Json           @default("{}")
  createdAt         DateTime       @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
  @@index([entityType, entityId])
  @@index([correlationId])
  @@index([occurredAt])
  @@map("audit_events")
}

enum ComplianceExportFormat {
  pdf
  csv
}

// Sprint 19 Part 13 — provenance for one export request. Never stores the
// generated file itself (storageReference stays null this sprint — see
// docs/AUDIT_TRAIL_ARCHITECTURE.md) — only enough metadata to answer "who
// exported what, when, covering how many records" after the fact.
model ComplianceExport {
  id                String                 @id @default(uuid())
  farmId            String
  requestedByUserId String?
  format            ComplianceExportFormat
  filtersJson       Json
  recordCount       Int
  generatedAt       DateTime               @default(now())
  checksum          String
  storageReference  String?
  expiresAt         DateTime?
  createdAt         DateTime               @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
  @@map("compliance_exports")
}

// ─── Core Tables ──────────────────────────────────────────────────────────────

model Farm {
  id                     String    @id @default(uuid())
  clerkUserId            String    @unique
  name                   String
  legalName              String?
  location               String
  city                   String?
  province               String?
  postalCode             String?
  country                String    @default("NL") @db.Char(2)
  farmType               FarmType  @default(arable)
  timezone               String    @default("Europe/Amsterdam")
  currency               String    @default("EUR") @db.Char(3)
  totalHectares          Decimal?  @db.Decimal(8, 2)
  brpNumber              String?
  vatNumber              String?
  latitude               Decimal?  @db.Decimal(9, 6)
  longitude              Decimal?  @db.Decimal(9, 6)
  onboardingCompletedAt  DateTime?
  overheadChoiceRecorded Boolean   @default(false)
  overheadPolicyNote     String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  seasons                 Season[]
  fields                  Field[]
  inventoryItems          InventoryItem[]
  machines                Machine[]
  employees               Employee[]
  complianceItems         ComplianceItem[]
  tasks                   Task[]
  auditEvents             AuditEvent[]
  complianceExports       ComplianceExport[]
  operationTemplates      OperationTemplate[]
  seasonPlanItems         SeasonPlanItem[]
  workOrders              WorkOrder[]
  inventoryReservations   InventoryReservation[]
  economicEntries         EconomicEntry[]
  inventoryPurchases      InventoryPurchase[]
  financialExpenses       FinancialExpense[]
  harvestResults          HarvestResult[]
  revenueEntries          RevenueEntry[]
  employeeRates           EmployeeRate[]
  machineRates            MachineRate[]
  contractorCosts         ContractorCost[]
  economicAllocations     EconomicAllocation[]
  aiBriefings             AiBriefing[]
  aiFeedback              AiBriefingFeedback[]
  aiRequests              AiRequestMetadata[]
  scoutingVisits          ScoutingVisit[]
  scoutingObservations    ScoutingObservation[]
  scoutingPhotos          ScoutingPhoto[]
  cropStageRecords        CropStageRecord[]
  photoAnnotationVersions PhotoAnnotationVersion[]

  @@map("farms")
}

model AiBriefing {
  id                     String           @id @default(uuid())
  farmId                 String
  generatedForDate       DateTime         @db.Date
  generatedAt            DateTime         @default(now())
  mode                   AiBriefingMode
  contextChecksum        String
  contextVersion         String
  promptVersion          String
  schemaVersion          String
  provider               String
  model                  String
  sourceDataTimestamp    DateTime
  weatherFreshness       String
  status                 AiBriefingStatus @default(current)
  topItemsSnapshot       Json
  secondaryItemsSnapshot Json
  whatChangedSnapshot    Json
  factsSnapshot          Json
  inputTokenCount        Int?
  outputTokenCount       Int?
  estimatedCostEur       Decimal?         @db.Decimal(12, 6)
  durationMs             Int
  fallbackReason         String?
  createdAt              DateTime         @default(now())

  farm     Farm                 @relation(fields: [farmId], references: [id], onDelete: Cascade)
  feedback AiBriefingFeedback[]
  requests AiRequestMetadata[]

  @@unique([farmId, generatedForDate, contextChecksum])
  @@index([farmId, generatedAt(sort: Desc)])
  @@index([farmId, generatedForDate])
  @@map("ai_briefings")
}

model AiBriefingFeedback {
  id              String            @id @default(uuid())
  farmId          String
  briefingId      String
  itemId          String
  feedbackType    AiFeedbackType
  reason          AiFeedbackReason?
  comment         String?
  actorUserId     String?
  contextChecksum String
  promptVersion   String
  model           String
  createdAt       DateTime          @default(now())

  farm     Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  briefing AiBriefing @relation(fields: [briefingId], references: [id], onDelete: Cascade)

  @@unique([briefingId, itemId, actorUserId])
  @@index([farmId, createdAt(sort: Desc)])
  @@index([briefingId, itemId])
  @@map("ai_briefing_feedback")
}

model AiRequestMetadata {
  id               String          @id @default(uuid())
  farmId           String
  briefingId       String?
  userReference    String?
  requestType      AiRequestType
  provider         String
  model            String
  contextChecksum  String?
  promptVersion    String
  schemaVersion    String
  startedAt        DateTime
  completedAt      DateTime
  durationMs       Int
  inputTokenCount  Int?
  outputTokenCount Int?
  estimatedCostEur Decimal?        @db.Decimal(12, 6)
  result           AiRequestResult
  retryCount       Int             @default(0)
  createdAt        DateTime        @default(now())

  farm     Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  briefing AiBriefing? @relation(fields: [briefingId], references: [id], onDelete: SetNull)

  @@index([farmId, requestType, createdAt(sort: Desc)])
  @@index([farmId, createdAt])
  @@index([contextChecksum])
  @@map("ai_request_metadata")
}

model Season {
  id        String   @id @default(uuid())
  farmId    String
  year      Int
  name      String?
  isActive  Boolean  @default(false)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())

  farm               Farm                @relation(fields: [farmId], references: [id], onDelete: Cascade)
  fieldSeasons       FieldSeason[]
  financialSnapshots FinancialSnapshot[]
  seasonPlanItems    SeasonPlanItem[]
  economicEntries    EconomicEntry[]
  inventoryPurchases InventoryPurchase[]
  financialExpenses  FinancialExpense[]
  harvestResults     HarvestResult[]
  revenueEntries     RevenueEntry[]
  contractorCosts    ContractorCost[]

  @@unique([farmId, year])
  @@map("seasons")
}

model Field {
  id              String      @id @default(uuid())
  farmId          String
  name            String
  hectares        Decimal     @db.Decimal(7, 2)
  soilType        SoilType    @default(loam)
  status          FieldStatus @default(healthy)
  ndviScore       Int?        @db.SmallInt
  brpParcelNumber String?     @db.VarChar(20)
  coordinates     Json?
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  farm               Farm                     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  fieldSeasons       FieldSeason[]
  soilAnalyses       SoilAnalysis[]
  externalProvenance FieldExternalProvenance?
  scoutingVisits     ScoutingVisit[]

  @@index([farmId])
  @@index([deletedAt])
  @@map("fields")
}

// Sprint 18 — provenance for a field imported from an official external
// source (currently only PDOK BRP Gewaspercelen). Deliberately a separate
// table rather than overloading the existing `brpParcelNumber` string
// column — a single VarChar can't honestly carry dataset year, an
// immutable geometry snapshot, area, source URL, and a confirmation
// timestamp. One row per imported field; a manually-created field has
// none. `importedGeometry`/`importedAreaHa` are a frozen snapshot of what
// was imported and are never overwritten by a later farmer edit to
// `Field.coordinates` — see Sprint_18_Ctgb_BRP_Report.md Part 12.
model FieldExternalProvenance {
  id                String    @id @default(uuid())
  fieldId           String    @unique
  source            String    @default("PDOK_BRPGewaspercelen")
  externalParcelId  String?
  datasetYear       Int
  importedGeometry  Json
  importedAreaHa    Decimal   @db.Decimal(7, 2)
  importedCropValue String?
  importedCropCode  Int?
  sourceUrl         String
  importedAt        DateTime  @default(now())
  userConfirmedAt   DateTime?
  geometryChecksum  String

  field Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@map("field_external_provenance")
}

model FieldSeason {
  id               String    @id @default(uuid())
  fieldId          String
  seasonId         String
  crop             CropName
  variety          String?
  sowingDate       DateTime? @db.Date
  harvestDate      DateTime? @db.Date
  targetYieldTHa   Decimal?  @db.Decimal(5, 2)
  actualYieldTHa   Decimal?  @db.Decimal(5, 2)
  bbchStage        Int?      @db.SmallInt
  diseaseRiskScore Int?      @db.SmallInt
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  field              Field                @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  season             Season               @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  activities         Activity[]
  tasks              Task[]
  seasonPlanItems    SeasonPlanItem[]
  workOrders         WorkOrder[]
  economicEntries    EconomicEntry[]
  financialExpenses  FinancialExpense[]
  harvestResults     HarvestResult[]
  revenueEntries     RevenueEntry[]
  ContractorCost     ContractorCost[]
  EconomicAllocation EconomicAllocation[]
  scoutingVisits     ScoutingVisit[]
  cropStageRecords   CropStageRecord[]

  @@unique([fieldId, seasonId])
  @@index([fieldId])
  @@index([seasonId])
  @@map("field_seasons")
}

model Activity {
  id                  String         @id @default(uuid())
  fieldSeasonId       String
  type                ActivityType
  status              ActivityStatus @default(completed)
  date                DateTime
  operatorName        String
  // Dutch RVO compliance fields
  certificateNumber   String?        @db.VarChar(50)
  waterVolumePerHa    Decimal?       @db.Decimal(7, 1)
  nozzleType          String?        @db.VarChar(50)
  machineId           String?
  // Product
  productId           String?
  dosePerHa           Decimal?       @db.Decimal(7, 3)
  doseUnit            String?        @db.VarChar(5)
  areaHa              Decimal        @db.Decimal(7, 2)
  // Weather at spray time
  weatherTempC        Decimal?       @db.Decimal(4, 1)
  weatherWindKmh      Int?           @db.SmallInt
  weatherWindDir      String?        @db.VarChar(3)
  weatherHumidity     Int?           @db.SmallInt
  weatherRainMm       Decimal?       @db.Decimal(5, 1)
  // Sprint 19 — BBCH growth stage AT THE TIME of this specific application.
  // Distinct from FieldSeason.bbchStage (that one tracks the crop's current
  // stage across the season and changes over time; this one is a frozen
  // fact about one activity, correctable like any other spray detail).
  bbchStage           Int?           @db.SmallInt
  notes               String?
  actualHours         Decimal?       @db.Decimal(7, 2)
  machineHours        Decimal?       @db.Decimal(7, 2)
  fuelUsed            Decimal?       @db.Decimal(10, 3)
  fuelInventoryItemId String?
  createdAt           DateTime       @default(now())
  deletedAt           DateTime?

  // Sprint 20 — stable client identifiers make retries after a lost HTTP
  // response return the original atomic result instead of applying stock
  // and compliance effects twice.
  offlineDraftId    String? @unique
  idempotencyKey    String? @unique
  submissionHash    String?
  syncCorrelationId String?

  // ─── Sprint 19 — regulated-record versioning (Parts 3, 4, 6, 16) ───────────
  // `version` is an optimistic-locking counter, incremented on every
  // correction/reversal — see docs/COMPLIANCE_RECORD_CORRECTION_POLICY.md
  // and Part 16's stale-version rejection.
  version          Int     @default(1)
  // Points at the immediately-previous version this row corrects (or, for a
  // reversal, the version it reverses). Null on an original record.
  correctionOfId   String?
  // Points at the ORIGINAL (root) record of this correction chain — equal
  // to correctionOfId only for the first correction; kept separately so the
  // whole chain can be queried in one indexed lookup without a recursive
  // CTE. Null on an original record (meaning "I am my own root").
  rootActivityId   String?
  // True only for the specific row created by reverseActivity() — a
  // reversal is a kind of correction, but one that always fully negates the
  // application rather than adjusting one or more fields.
  isReversal       Boolean @default(false)
  // Required (enforced in application code, not at the DB level, since an
  // original record legitimately has none) whenever correctionOfId is set.
  correctionReason String?
  // { field: { old, new } } for exactly the fields that changed — enough
  // for the Compliance page's "old vs new" detail view without re-deriving
  // it from two full row reads every time.
  correctionDiff   Json?

  fieldSeason         FieldSeason                  @relation(fields: [fieldSeasonId], references: [id], onDelete: Cascade)
  product             InventoryItem?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  fuelInventoryItem   InventoryItem?               @relation("ActivityFuelInventory", fields: [fuelInventoryItemId], references: [id], onDelete: SetNull)
  machine             Machine?                     @relation(fields: [machineId], references: [id], onDelete: SetNull)
  stockMovements      StockMovement[]
  complianceRecords   ComplianceRecord[]
  correctionOf        Activity?                    @relation("ActivityVersionChain", fields: [correctionOfId], references: [id], onDelete: Cascade)
  corrections         Activity[]                   @relation("ActivityVersionChain")
  completedWorkOrder  WorkOrder?                   @relation("CompletedWorkOrder")
  costSnapshots       ActivityCostSnapshot[]
  labourSnapshots     ActivityLabourCostSnapshot[]
  machineCostSnapshot ActivityMachineCostSnapshot?
  contractorCosts     ContractorCost[]
  harvestResult       HarvestResult?

  @@index([fieldSeasonId])
  @@index([date(sort: Desc)])
  @@index([deletedAt])
  @@index([machineId])
  @@index([fuelInventoryItemId])
  @@index([correctionOfId])
  @@index([rootActivityId])
  @@map("activities")
}

model InventoryItem {
  id                     String            @id @default(uuid())
  farmId                 String
  name                   String
  category               InventoryCategory
  activeIngredient       String?
  unit                   InventoryUnit
  currentStock           Decimal           @db.Decimal(10, 3)
  minimumStock           Decimal           @default(0) @db.Decimal(10, 3)
  purchasePricePerUnit   Decimal?          @db.Decimal(8, 2)
  valuationEffectiveAt   DateTime?
  expiryDate             DateTime?         @db.Date
  supplierName           String?
  registrationNumber     String?
  fracCode               String?
  hracCode               String?
  phiDays                Int?              @db.SmallInt
  nitrogenPercent        Decimal?          @db.Decimal(5, 2)
  phosphorusPercent      Decimal?          @db.Decimal(5, 2)
  potassiumPercent       Decimal?          @db.Decimal(5, 2)
  // Sprint 18 — Ctgb integration. Defaults to true so every pre-Sprint-18
  // row (all free-text entry, the only path that ever existed) keeps its
  // honest meaning: manual/unverified unless explicitly linked to a real
  // Ctgb authorisation record.
  isManualEntry          Boolean           @default(true)
  ctgbProductReferenceId String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  farm                  Farm                          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  ctgbProductReference  CtgbProductReference?         @relation(fields: [ctgbProductReferenceId], references: [id], onDelete: SetNull)
  activities            Activity[]
  stockMovements        StockMovement[]
  reservations          InventoryReservation[]
  seasonPlanItems       SeasonPlanItem[]
  purchases             InventoryPurchase[]
  activityCostSnapshots ActivityCostSnapshot[]
  fuelCostSnapshots     ActivityMachineCostSnapshot[] @relation("FuelInventorySnapshots")
  activityFuelUses      Activity[]                    @relation("ActivityFuelInventory")

  @@index([farmId])
  @@index([ctgbProductReferenceId])
  @@map("inventory_items")
}

enum CtgbAuthorisationStatus {
  authorised
  expired
  withdrawn
  suspended
  unknown
}

// Sprint 18 — a normalized, cached snapshot of one official Ctgb
// authorisation record. Never the live source of truth (Ctgb itself is);
// this is what FarmOS last successfully fetched and verified, with enough
// provenance (source URL, fetchedAt, checksum) to know how stale it is.
model CtgbProductReference {
  id                  String                  @id @default(uuid())
  sourceProductId     String                  @unique
  authorisationNumber String
  officialName        String
  authorisationStatus CtgbAuthorisationStatus @default(unknown)
  authorisationStart  DateTime?               @db.Date
  authorisationEnd    DateTime?               @db.Date
  holder              String?
  activeSubstances    Json?
  sourceUrl           String
  fetchedAt           DateTime
  sourceVersion       String?
  rawChecksum         String
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  uses           CtgbUseAuthorisation[]
  inventoryItems InventoryItem[]

  @@index([authorisationNumber])
  @@map("ctgb_product_references")
}

// One official permitted use (crop/target + its constraints) for a given
// product. A single product typically has many of these. Every constraint
// field is nullable and independently sourced — never invented when the
// official record doesn't state it (Sprint 18 Part 4: "do not assume
// every field exists in the API").
model CtgbUseAuthorisation {
  id                       String   @id @default(uuid())
  productReferenceId       String
  cropOrUseTarget          String
  purpose                  String?
  dosePerHaMin             Decimal? @db.Decimal(7, 3)
  dosePerHaMax             Decimal? @db.Decimal(7, 3)
  doseUnit                 String?  @db.VarChar(10)
  maxApplicationsPerSeason Int?     @db.SmallInt
  applicationIntervalDays  Int?     @db.SmallInt
  bbchMin                  Int?     @db.SmallInt
  bbchMax                  Int?     @db.SmallInt
  phiDays                  Int?     @db.SmallInt
  bufferZoneMetres         Decimal? @db.Decimal(5, 1)
  otherRestrictions        String?
  sourceDocumentRef        String?
  createdAt                DateTime @default(now())

  productReference CtgbProductReference @relation(fields: [productReferenceId], references: [id], onDelete: Cascade)

  @@index([productReferenceId])
  @@map("ctgb_use_authorisations")
}

model StockMovement {
  id              String         @id @default(uuid())
  inventoryItemId String
  activityId      String?
  quantity        Decimal        @db.Decimal(10, 3)
  direction       StockDirection
  unitCost        Decimal?       @db.Decimal(8, 2)
  notes           String?
  createdAt       DateTime       @default(now())
  // Sprint 19 Part 5 — links this movement to the specific correction/
  // reversal business transaction that created it, so every movement from
  // one correction (which may add more than one row) can be queried
  // together. Null for movements created before this sprint or by the
  // original (non-corrective) create/complete flow, which doesn't need it —
  // those are already unambiguously tied to their activityId alone.
  correlationId   String?
  purchaseId      String?

  inventoryItem InventoryItem      @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  activity      Activity?          @relation(fields: [activityId], references: [id], onDelete: SetNull)
  purchase      InventoryPurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId])
  @@index([activityId])
  @@index([correlationId])
  @@index([purchaseId])
  @@map("stock_movements")
}

