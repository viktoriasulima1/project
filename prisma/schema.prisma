model EconomicAllocation {
  id                  String               @id @default(uuid())
  farmId              String
  economicEntryId     String
  fieldSeasonId       String?
  percentage          Decimal              @db.Decimal(7, 4)
  amount              Decimal              @db.Decimal(14, 2)
  originalAmount      Decimal              @db.Decimal(14, 2)
  method              CostAllocationMethod
  version             Int                  @default(1)
  status              EconomicRecordStatus @default(active)
  correctionOfId      String?
  reason              String?
  createdAt           DateTime             @default(now())
  // Sprint 25 reallocation write path. idempotencyKey is SHARED across all
  // destination rows of one reallocation (one reallocation → many rows), so
  // it is indexed, not unique. submissionHash guards same-key/different-payload.
  idempotencyKey      String?
  submissionHash      String?
  correlationId       String?
  createdBy           String?
  sourceRecordVersion Int?

  farm          Farm                 @relation(fields: [farmId], references: [id], onDelete: Cascade)
  economicEntry EconomicEntry        @relation(fields: [economicEntryId], references: [id], onDelete: Cascade)
  fieldSeason   FieldSeason?         @relation(fields: [fieldSeasonId], references: [id], onDelete: SetNull)
  correctionOf  EconomicAllocation?  @relation("AllocationVersions", fields: [correctionOfId], references: [id], onDelete: SetNull)
  corrections   EconomicAllocation[] @relation("AllocationVersions")

  @@index([farmId, status])
  @@index([economicEntryId])
  @@index([farmId, idempotencyKey])
  @@map("economic_allocations")
}

model InventoryPurchase {
  id               String               @id @default(uuid())
  farmId           String
  seasonId         String
  inventoryItemId  String
  supplier         String?
  purchaseDate     DateTime             @db.Date
  quantity         Decimal              @db.Decimal(14, 3)
  unit             InventoryUnit
  totalAmount      Decimal              @db.Decimal(14, 2)
  unitCost         Decimal              @db.Decimal(12, 4)
  vatAmount        Decimal?             @db.Decimal(12, 2)
  batchLot         String?
  invoiceReference String?
  notes            String?
  status           EconomicRecordStatus @default(active)
  correctionOfId   String?
  correlationId    String
  createdAt        DateTime             @default(now())
  offlineDraftId   String?              @unique
  idempotencyKey   String?              @unique
  submissionHash   String?
  correctionReason String?
  version          Int                  @default(1)

  farm           Farm                @relation(fields: [farmId], references: [id], onDelete: Cascade)
  season         Season              @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  inventoryItem  InventoryItem       @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  correctionOf   InventoryPurchase?  @relation("PurchaseAdjustments", fields: [correctionOfId], references: [id], onDelete: SetNull)
  corrections    InventoryPurchase[] @relation("PurchaseAdjustments")
  stockMovements StockMovement[]

  @@unique([farmId, invoiceReference])
  @@index([farmId, purchaseDate])
  @@index([inventoryItemId])
  @@map("inventory_purchases")
}

model FinancialExpense {
