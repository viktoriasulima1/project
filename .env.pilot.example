# ─── Pilot environment — copy to .env.pilot and fill in real values ──────────
# .env.pilot is gitignored. Never commit real secrets here or anywhere else.
# This file only ever holds placeholders.

# ─── Isolated pilot database ──────────────────────────────────────────────────
# MUST be a database distinct from both local development (farmos) and E2E
# (farmos_e2e) — created once via:
#   npx prisma db execute --url "postgresql://postgres:password@localhost:5432/postgres" --file e2e/setup/create-pilot-db.sql
#   DATABASE_URL=<this same URL> npx prisma migrate deploy
# If/when this moves to a hosted database, replace this with that provider's
# connection string — the separation requirement (never share with dev/E2E)
# still applies.
PILOT_DATABASE_URL="postgresql://pilot_user:password@host.example:5432/farmos_pilot"
DATABASE_URL="postgresql://pilot_user:password@host.example:5432/farmos_pilot"

# ─── Separate Clerk PRODUCTION instance; test keys are rejected ───────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_..."
CLERK_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_APP_URL="https://pilot.example.nl"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL="/sign-in"

# ─── Weather ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FARM_LATITUDE="51.9652"
NEXT_PUBLIC_FARM_LONGITUDE="5.9307"

# ─── Explicitly absent from this file, on purpose ─────────────────────────────
# ALLOW_DEV_FARM_FALLBACK must NEVER be set for the pilot. It is dev-only by
# design (getActiveFarm() requires NODE_ENV === 'development' in addition to
# this flag), but the pilot environment should not even carry the variable,
# to make the absence obvious on inspection.

# ─── Pilot version identifier ─────────────────────────────────────────────────
# Set this to the exact commit/tag deployed, so any bug report or screenshot
# can be tied to a specific build. Surfaced nowhere in the UI yet — read
# manually from this variable or `git rev-parse HEAD` on the deployed host.
PILOT_VERSION="sprint-22-pilot-v1"
NEXT_PUBLIC_BUILD_VERSION="sprint-22-pilot-v1"
PILOT_BASE_URL="https://pilot.example.nl"
PILOT_MIGRATION_CONFIRM="false"

NODE_ENV="production"
