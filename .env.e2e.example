# ─── E2E environment — copy to .env.e2e and fill in real values ──────────────
# .env.e2e is gitignored. Never commit real secrets or passwords here or
# anywhere else. This file (.env.e2e.example) only ever holds placeholders.

# ─── Isolated E2E database ────────────────────────────────────────────────────
# MUST point at a database that is NOT the real dev/prod database, and its
# name MUST contain "e2e" or "test" — e2e/setup/reset-db.ts refuses to run
# otherwise. Created once via:
#   npx prisma db execute --url "postgresql://postgres:password@localhost:5432/postgres" --file e2e/setup/create-e2e-db.sql
#   DATABASE_URL=<this same URL> npx prisma migrate deploy
E2E_DATABASE_URL="postgresql://postgres:password@localhost:5432/farmos_e2e"

# Explicit opt-in required before e2e/setup/reset-db.ts will delete anything.
# Playwright's global setup sets this itself for the duration of a test run —
# you should not normally need to set it by hand.
E2E_RESET_CONFIRM="true"

# Explicit opt-in required before e2e/setup/reset-user-data.ts will delete or
# reseed a single named E2E user's own FarmOS records. Distinct from
# E2E_RESET_CONFIRM above (that one wipes the whole farmos_e2e database; this
# one scopes to one user's rows). Playwright's global setup and the per-test
# reset helpers set this themselves for the duration of a test run.
E2E_ALLOW_RESET="true"

# Explicit opt-in required before `npm run clerk:e2e:cleanup` will actually
# delete anything. Without this set, that script only lists (dry-run) the
# legacy throwaway Clerk users it would delete. Never set by any normal test
# run or global setup — this is a deliberate, manual, occasional operation.
# See docs/E2E_Clerk_User_Quota_Audit.md.
CLERK_E2E_CLEANUP_CONFIRM="false"

# ─── App under test ───────────────────────────────────────────────────────────
# Base URL Playwright drives. playwright.config.ts's webServer starts the app
# itself (dev or production build, selected via E2E_TARGET below) against
# E2E_DATABASE_URL, so this should normally stay as the local default.
E2E_BASE_URL="http://localhost:3100"

# "dev" runs against `next dev`; "build" runs `next build && next start"
# against a production build (required for Part 10 of Sprint 12 — production-
# like validation). Defaults to "dev" if unset.
E2E_TARGET="dev"

# ─── Clerk (test-mode instance only — never point this at a live instance) ───
# @clerk/testing's Playwright helpers read these exact (non-NEXT_PUBLIC-
# prefixed) names. Use the SAME test-mode keys already in .env.local — do not
# create separate keys just for this file, and never use live (`pk_live_...`
# / `sk_live_...`) keys here under any circumstances.
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# ─── E2E test identities — fixed pool of 4, created ONCE and reused forever ──
# All four MUST use a `+clerk_test` email local-part (e.g.
# "name+clerk_test@example.com") — Clerk's test mode auto-verifies these and
# never sends real email, so no inbox access is ever needed. No password is
# required: sign-in happens via @clerk/testing's ticket-based
# `clerk.signIn({ page, emailAddress })`, which mints a real sign-in ticket
# through Clerk's own Backend API rather than typing a password into the UI —
# there is deliberately no password to generate, store, or leak.
#
# Users are created idempotently by e2e/setup/create-test-users.ts (checks
# for an existing user by email before creating) — safe to run repeatedly.
# This is a FIXED, SMALL pool. Do not add per-test or timestamp-based emails
# here or anywhere else — see docs/E2E_Clerk_User_Quota_Audit.md for why that
# previously exhausted this project's 100-user Clerk development-instance quota.
# "Freshness" for a given test comes from resetting that user's FarmOS data
# (e2e/setup/reset-user-data.ts), never from creating a new Clerk user.

# User NEW: reused for every "no farm yet" / onboarding-redirect scenario.
# Its FarmOS data (if any) is deleted before each test that needs a truly
# fresh state — see resetE2eUserFarmData() in e2e/setup/reset-user-data.ts.
E2E_USER_NEW_EMAIL="e2e-user-new+clerk_test@example.com"

# User READY: has a fully set-up, STABLE farm (season, field, crop,
# inventory), seeded once in global setup by e2e/setup/seed-farms.ts. Most
# read-mostly feature/failure/accessibility/mobile tests run as this user and
# must not destructively mutate its farm.
E2E_USER_READY_EMAIL="e2e-user-ready+clerk_test@example.com"

# User OTHER: has its own, separate seeded farm — used only for cross-farm
# isolation tests. Must never share any record with User READY's farm, and
# (like READY) is not destructively mutated by individual tests.
E2E_USER_OTHER_EMAIL="e2e-user-other+clerk_test@example.com"

# User PILOT: a reusable but freely-mutable identity. Tests that used to call
# createThrowawayUser() (Ctgb/BRP flows, Finance/Insights/weather-failure
# golden flows) now reuse PILOT instead, resetting and reseeding its farm data
# at the start of each such test via resetE2eUserFarmData()/seedOtherE2eFarm()
# equivalents. Safe because Playwright runs this suite with a single worker
# (fullyParallel: false), so PILOT's data is never touched concurrently.
E2E_USER_PILOT_EMAIL="e2e-user-pilot+clerk_test@example.com"
